{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.6.5",
        "drupal/ai_interpolator": "^1.0@RC",
        "drupal/ai_interpolator_openai": "^1.0@RC",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/bootstrap_layout_builder": "^2.0",
        "drupal/classy": "^2.0",
        "drupal/color_field": "^3.0",
        "drupal/commerce": "^3.3.10",
        "drupal/commerce_paypal": "^2.0",
        "drupal/commerce_product_taxonomy_filter": "1.0.x-dev@dev",
        "drupal/commerce_shipping": "^3.0",
        "drupal/config_rewrite": "^1.3",
        "drupal/core-composer-scaffold": "10.6.18",
        "drupal/core-project-message": "10.6.18",
        "drupal/core-recommended": "10.6.18",
        "drupal/crop": "^2.0",
        "drupal/entity": "^1.8",
        "drupal/entity_reference_facet_link": "^2.0",
        "drupal/facets": "^3.0",
        "drupal/facets_pretty_paths": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/flag": "^5.0",
        "drupal/flag_anon": "^1.1",
        "drupal/flippy": "^2.0@beta",
        "drupal/fontawesome": "^3.0",
        "drupal/image_widget_crop": "^3.0",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/layout_builder_blocks": "^1.0",
        "drupal/layout_builder_browser": "^1.2",
        "drupal/layout_builder_modal": "^2.0",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/mailchimp": "^3.1",
        "drupal/media_external": "^1.0@beta",
        "drupal/metatag": "^2.0",
        "drupal/metatag_ai": "^1.0",
        "drupal/openai": "^1.0@beta",
        "drupal/paragraphs": "^1.8",
        "drupal/paragraphs_table": "^2.0",
        "drupal/pathauto": "^1.11",
        "drupal/quick_node_clone": "^1.22",
        "drupal/search_api": "^1.19",
        "drupal/sitemap": "^2.4",
        "drupal/stable": "^2.0",
        "drupal/statistics": "^1.0",
        "drupal/styleguide": "^2.0",
        "drupal/superfish": "^1.6",
        "drupal/upgrade_status": "^4.3",
        "drupal/video_embed_field": "^3.1",
        "drupal/views_base_url": "^2.1@beta",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/webform": "^6.3",
        "drush/drush": "^12.0",
        "morethanthemes/commerce_product_outofstock_extra": "dev-main",
        "morethanthemes/mt_layout_page": "^1.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "zaporylie/composer-drupal-optimizations": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./"
            }
        },
        "installer-paths": {
            "core": [
                "type:drupal-core"
            ],
            "libraries/{$name}": [
                "type:drupal-library"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "enable-patching" : true,
            "drupal/paragraphs": {
                "Paragraphs do not render: access check for view fail when using layout builder": "https://www.drupal.org/files/issues/2026-07-06/paragraphs-parent-access-block-content-skip-3090200-97.patch"
            },
            "drupal/openai": {
                "New, long keys can't be stored properly": "https://www.drupal.org/files/issues/2024-08-02/3465426.patch"
            },
            "drupal/flag_anon": {
                "PHP Fatal error: Declaration of Drupal": "https://www.drupal.org/files/issues/2025-01-29/flag_anon-fatal-php-error-3097962-9.patch"
            },
            "drupal/flag": {
                "Allow AjaxResponse to be altered": "https://www.drupal.org/files/issues/2026-09-11/allow-ajaxresponse-to-be-altered.patch"
            }
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
